# Copy to .env and fill. Never commit .env.

# --- required ---
LITELLM_MASTER_KEY=sk-change-this      # the only client credential for :4040
POSTGRES_PASSWORD=change-this-too      # litellm-db password

# --- free backends (get keys from each provider) ---
NVIDIA_API_KEY=                        # build.nvidia.com — free NIM tier
MISTRAL_API_KEY=                       # console.mistral.ai — free tier

# --- flat-rate / subscription backends (optional) ---
ZAI_API_KEY=                           # z.ai GLM Coding Plan (flat-rate)
ZEN_API_KEY=                           # opencode Zen: free tier + GO subscription
ZEN_PAID_API_KEY=                      # opencode Zen per-token overflow ($ balance); leave blank to disable

# GitHub Copilot needs no key here — OAuth device flow on first use (scripts/copilot_device_flow.sh).
# Anthropic Claude Max needs no key here — OAuth via `claude /login`, token read from macOS Keychain.
